---
/**
 * "Sign in to MSDEVBUILD": what [data-account-signin] opens on sites that use
 * the shared sign-in (src/account.ts), i.e. the blog. One account for every
 * MSDEVBUILD site, and signing in here signs you in there too (src/sso.ts).
 * azure.msdevbuild.com has its own dialog (more providers) with the same words.
 */
import { BRAND } from '../src/brand';
interface Props {
  /** The site's logo/app icon. */
  logo?: string;
  privacy?: string;
  terms?: string;
}
const { logo = '/favicon.svg', privacy = '/privacy/', terms } = Astro.props;
---
<dialog id="msdb-signin" class="msdb-sid" aria-labelledby="msdb-sid-h" aria-describedby="msdb-sid-sub">
  <form method="dialog" class="msdb-sid-x"><button aria-label="Close">×</button></form>
  <img src={logo} alt="" width="56" height="56" class="msdb-sid-logo" />
  <h2 id="msdb-sid-h">Sign in to MSDEVBUILD</h2>
  <p id="msdb-sid-sub" class="msdb-sid-sub">One account for the blog and Azure certifications. Sign in here and you are signed in on both.</p>
  <button type="button" class="msdb-sid-google" data-msdb-provider="google">
    <svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
    <span>Continue with Google</span>
  </button>
  <p class="msdb-sid-status" role="status" aria-live="polite"></p>
  <ul class="msdb-sid-points">
    <li>Optional: everything works without an account.</li>
    <li>We never post anything for you.</li>
  </ul>
  <p class="msdb-sid-legal">By continuing you agree to our {terms && <><a href={terms}>Terms</a> and </>}<a href={privacy}>Privacy Policy</a>. {BRAND.org}</p>
</dialog>

<script>
  import { signIn } from '../src/account';
  const MSG: Record<string, string> = {
    'auth/unauthorized-domain': 'Sign-in isn’t switched on for this address yet. Please try again later.',
    'auth/network-request-failed': 'You seem to be offline. Connect and try again.',
  };
  const bind = () => {
    const dlg = document.getElementById('msdb-signin') as HTMLDialogElement | null;
    if (!dlg || dlg.dataset.bound === '') return;
    dlg.dataset.bound = '';
    const btn = dlg.querySelector<HTMLButtonElement>('[data-msdb-provider]')!;
    const status = dlg.querySelector<HTMLElement>('.msdb-sid-status')!;
    btn.addEventListener('click', () => { status.textContent = 'Opening Google…'; btn.disabled = true; void signIn(); });
    window.addEventListener('msdb-sync', (e) => {
      const d = (e as CustomEvent<{ state: string; code?: string }>).detail;
      if (d.state === 'error') { btn.disabled = false; status.textContent = MSG[d.code ?? ''] ?? 'Couldn’t sign you in. Please try again.'; }
      if (d.state === 'idle') { btn.disabled = false; if (!document.documentElement.dataset.auth?.includes('in')) status.textContent = ''; }
    });
    window.addEventListener('msdb-auth', (e) => { if ((e as CustomEvent).detail && dlg.open) dlg.close(); });
    dlg.addEventListener('close', () => { status.textContent = ''; btn.disabled = false; });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  };
  bind();
  document.addEventListener('astro:after-swap', bind);
</script>

<style is:global>
  .msdb-sid { width: min(25rem, calc(100vw - 2rem)); margin: auto; padding: 1.75rem 1.5rem 1.4rem; border: 1px solid var(--border, #d5dfea); border-radius: 1.2rem; background: var(--bg, #fff); color: var(--text, #0b1020); text-align: center; }
  .msdb-sid::backdrop { background: rgb(0 0 0 / .45); backdrop-filter: blur(2px); }
  .msdb-sid-x { position: absolute; top: .6rem; right: .6rem; }
  .msdb-sid-x button { width: 2rem; height: 2rem; border: 0; border-radius: 999px; background: transparent; color: inherit; font-size: 1.3rem; cursor: pointer; }
  .msdb-sid-x button:hover { background: var(--bg-subtle, #f3f8fd); }
  .msdb-sid-logo { margin: 0 auto .75rem; border-radius: 1rem; }
  .msdb-sid h2 { margin: 0; font-size: 1.35rem; font-weight: 700; }
  .msdb-sid-sub { margin: .45rem 0 1.25rem; font-size: .9rem; line-height: 1.5; color: var(--text-muted, #4a5163); }
  .msdb-sid-google { display: flex; align-items: center; justify-content: center; gap: .65rem; width: 100%; min-height: 2.9rem; padding: .6rem 1rem; border: 1px solid var(--border, #d5dfea); border-radius: 999px; background: var(--bg, #fff); color: var(--text, #0b1020); font: inherit; font-weight: 650; cursor: pointer; }
  .msdb-sid-google:hover { border-color: var(--accent, #0078d4); }
  .msdb-sid-google:disabled { opacity: .65; cursor: progress; }
  .msdb-sid-google:focus-visible, .msdb-sid-x button:focus-visible { outline: 2px solid var(--accent, #0078d4); outline-offset: 2px; }
  .msdb-sid-status { min-height: 1.2rem; margin: .6rem 0 0; font-size: .85rem; color: var(--accent, #0078d4); }
  .msdb-sid-points { list-style: none; margin: .6rem 0 0; padding: 0; font-size: .8rem; color: var(--text-muted, #4a5163); }
  .msdb-sid-legal { margin: .9rem 0 0; font-size: .75rem; color: var(--text-muted, #4a5163); }
  .msdb-sid-legal a { color: var(--accent, #0078d4); }
</style>
