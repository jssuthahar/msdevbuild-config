{
  "name": "@msdevbuild/config",
  "version": "0.1.0",
  "description": "Shared MSDEVBUILD brand: design tokens, brand data and a few Astro components used by every MSDEVBUILD site.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jssuthahar/msdevbuild-config.git"
  },
  "keywords": [
    "astro-component",
    "msdevbuild"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./brand": "./src/brand.ts",
    "./tokens.css": "./styles/tokens.css",
    "./components/*": "./components/*",
    "./base.css": "./styles/base.css",
    "./firebase": "./src/firebase.ts",
    "./engage": "./src/engage.ts",
    "./activity": "./src/activity.ts",
    "./account": "./src/account.ts",
    "./country": "./src/country.ts",
    "./scripts/*": "./scripts/*"
  },
  "files": [
    "components",
    "scripts",
    "src",
    "styles"
  ],
  "peerDependencies": {
    "astro": ">=5",
    "tailwindcss": ">=4"
  }
}
